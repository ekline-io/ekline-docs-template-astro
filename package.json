{
  "name": "ekline-docs-template-astro",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "dev:sso": "node tests/mock-sso/server.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "astro check",
    "test:visual": "npm run build && playwright test",
    "test:visual:ci": "npm run build && playwright test --grep-invert @screenshot",
    "test:visual:update": "npm run build && playwright test --update-snapshots"
  },
  "overrides": {
    "@scalar/astro": {
      "astro": "$astro"
    }
  },
  "dependencies": {
    "@astrojs/node": "10.1.1",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/starlight": "^0.39.2",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@astrojs/vercel": "^10.0.8",
    "@ekline/starlight-contextual-menu": "^0.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@scalar/astro": "^0.4.14",
    "@scalar/openapi-parser": "^0.28.14",
    "@scalar/workspace-store": "^0.57.1",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.2.2",
    "jose": "^6.2.9",
    "sharp": "^0.34.5",
    "starlight-llms-txt": "^0.8.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "typescript": "^6.0.3"
  }
}
