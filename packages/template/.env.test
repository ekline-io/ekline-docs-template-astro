# Test/dev SSO configuration — committed on purpose, and safe to commit.
#
# These are the same fake values as `.env.example`, in a file the test scripts
# can load. They exist because the auth controls are now derived from
# configuration: a build with no `DOCS_*` set correctly omits them, which would
# make every header test fail for the right reason and the wrong purpose.
#
# `.env.test` is NOT read by an ordinary build. Astro's `loadEnv` reads `.env`,
# `.env.local`, `.env.<mode>` and `.env.<mode>.local`, and the mode is
# `production` for `astro build` — so this file only ever applies where a script
# loads it explicitly, which is `test:visual*` in package.json and
# `playwright.config.mjs`.
DOCS_SSO_URL=http://localhost:4545/docs-sso
DOCS_SSO_SECRET=dev-only-sso-not-a-secret
DOCS_SESSION_SECRET=dev-only-session-not-a-secret

# The demo login is on for the test build and preview server: the Playwright
# suite drives /demo-login directly (tests/visual/demo-login.spec.mjs). The
# flag's off-state is covered at the unit level (tests/demo-login.test.mjs);
# the mock SSO server remains DOCS_SSO_URL here, so the existing auth specs
# keep exercising the customer-endpoint round trip unchanged.
DOCS_UNSAFE_DEMO_LOGIN=1
