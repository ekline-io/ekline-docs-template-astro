# build output (cheap insurance against a stray build at the repo root;
# each project under packages/ and apps/ has its own .gitignore for this)
dist/
.astro/
.vercel/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# macOS-specific files
.DS_Store

# environment variables — repo-wide, not only in the template. This repo
# handles SSO secrets; a stray .env anywhere must not be committable.
.env
.env.production
