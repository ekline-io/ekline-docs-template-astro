---
/**
 * Starlight MobileMenuFooter override.
 *
 * Upstream's version, plus the Log in / Log out control.
 *
 * It has to be here as well as in the header, not instead of it. The header's
 * right-hand cluster is `sl-hidden md:sl-flex`, so below the `md` breakpoint it
 * is not rendered at all — which is why Starlight repeats the theme, language
 * and social controls in this footer. Without the same treatment, a reader on a
 * phone has no way to sign in or out: the only other affordance is the sidebar
 * entry, and that one is hidden until they are already signed in.
 *
 * Children come through Starlight's virtual modules so any other component
 * override configured in `astro.config.mjs` is still honoured — same reasoning
 * as `CustomHeader.astro`. If you upgrade Starlight and the upstream footer
 * changes shape, re-sync from:
 *   node_modules/@astrojs/starlight/components/MobileMenuFooter.astro
 */
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import AuthControl from './AuthControl.astro';
import { showAuthControls } from '../config/sidebar.mjs';
---

<div class="mobile-preferences sl-flex">
	<div class="social-icons">
		<SocialIcons />
	</div>
	<ThemeSelect />
	<LanguageSelect />
	{showAuthControls && <AuthControl />}
</div>

<style>
	@layer starlight.core {
		.social-icons {
			display: flex;
			margin-inline-end: auto;
			gap: 1rem;
			align-items: center;
			padding-block: 1rem;
		}
		.social-icons:empty {
			display: none;
		}
		.mobile-preferences {
			justify-content: space-between;
			flex-wrap: wrap;
			border-top: 1px solid var(--sl-color-gray-6);
			column-gap: 1rem;
			padding: 0.5rem 0;
		}
	}
</style>
