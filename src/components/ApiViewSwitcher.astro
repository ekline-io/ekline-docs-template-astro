---
/**
 * Segmented control for switching between the API reference views.
 *
 * Rendered only when more than one view is enabled — see
 * `src/config/api-reference.mjs`. With a single view there is nothing to
 * choose, so the control disappears rather than showing one dead option.
 *
 * The links carry no hash server-side; a script rewrites them on the client to
 * preserve wherever the reader currently is, so switching views keeps your
 * place in the document instead of dropping you back at the top.
 *
 * Two details on the markup below, both of which `astro check` cares about:
 *
 * - `data-*` attributes are written as `=""` rather than bare. Astro types them
 *   as strings, so a valueless one is a boolean and fails type-checking.
 * - Comments cannot sit inside an element's attribute list; they parse as
 *   attributes and cascade into a wall of syntax errors. Hence this block.
 *
 * `data-astro-reload` forces a full page load instead of a view transition.
 * Switching views remounts Scalar either way — the layouts differ — but across
 * a client-side swap it remounts at scroll zero and its scroll-spy rewrites the
 * hash to the top of the document before it reads the one we arrived with. The
 * reader lands back at the introduction, which is exactly what carrying the
 * hash exists to prevent. On a full load Scalar reads the hash at mount.
 */
import { enabledViews, routeFor } from '../config/api-reference.mjs';

interface Props {
	/** `id` of the view being rendered, so it can be marked as current. */
	current: string;
}

const { current } = Astro.props;
---

{
	enabledViews.length > 1 && (
		<nav class="ek-view-switcher" aria-label="API reference view">
			{enabledViews.map((view) => (
				<a
					href={routeFor(view)}
					data-ek-view-link=""
					data-astro-reload=""
					aria-current={view.id === current ? 'page' : undefined}
				>
					{view.label}
				</a>
			))}
		</nav>
	)
}

<script>
	/**
	 * Carry the reader's position across a view switch.
	 *
	 * Scalar keeps the URL hash pointed at the operation in view, so copying the
	 * current hash onto the switcher's links means changing layout keeps your
	 * place. Without this, a reader deep in a long document is returned to the
	 * top purely for changing how the page is laid out.
	 *
	 * The href is rewritten on each interaction rather than once at load, because
	 * the hash changes continuously as the reader scrolls.
	 */
	function carryHash(event: Event) {
		const link = (event.target as HTMLElement | null)?.closest<HTMLAnchorElement>(
			'[data-ek-view-link]'
		);
		if (!link) return;

		const target = new URL(link.href, location.origin);
		target.hash = location.hash;
		link.href = target.toString();
	}

	// `pointerdown` and `focusin` both land before the navigation the click
	// starts, and between them cover pointer and keyboard use.
	document.addEventListener('pointerdown', carryHash);
	document.addEventListener('focusin', carryHash);
</script>

<style>
	/*
	 * Styled from Starlight's own props, so the control inherits the site theme —
	 * including a customer's palette — with no colours of its own.
	 */
	.ek-view-switcher {
		display: inline-flex;
		gap: 0.125rem;
		padding: 0.1875rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background-color: var(--sl-color-black);
	}

	.ek-view-switcher a {
		padding: 0.25rem 0.625rem;
		border-radius: 0.375rem;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		line-height: 1.6;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		white-space: nowrap;
		transition:
			background-color 120ms ease,
			color 120ms ease;
	}

	.ek-view-switcher a:hover {
		color: var(--sl-color-white);
		background-color: var(--sl-color-gray-6);
	}

	.ek-view-switcher a[aria-current='page'] {
		color: var(--sl-color-text-accent);
		background-color: color-mix(in srgb, var(--sl-color-text-accent) 12%, transparent);
	}

	/* Keep the focus ring visible against both the rest and current states. */
	.ek-view-switcher a:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: -2px;
	}
</style>
