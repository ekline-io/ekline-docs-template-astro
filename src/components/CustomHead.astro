---
/**
 * Starlight Head override.
 *
 * Adds two head-level enhancements on top of Starlight's default <head>:
 *
 *   1. `<ClientRouter />` — Astro view transitions for smooth SPA-style
 *      navigation between pages.
 *
 *   2. `<link rel="alternate" type="text/markdown" href="…">` — pointer to
 *      the page's Markdown twin (served by `@ekline/starlight-contextual-menu`
 *      at `<page>.md`). Well-behaved AI crawlers (GPTBot, ClaudeBot, …) use
 *      the `<link rel="alternate">` convention to discover non-HTML
 *      representations of a page. The plugin's component only emits the tag
 *      for pages that actually have a markdown twin (filters out virtual
 *      entries from e.g. `starlight-openapi`).
 *
 * Docs:
 *   https://docs.astro.build/en/guides/view-transitions/
 *   https://starlight.astro.build/guides/overriding-components/
 */
import Default from '@astrojs/starlight/components/Head.astro';
import MarkdownAlternate from '@ekline/starlight-contextual-menu/MarkdownAlternate.astro';
import { ClientRouter } from 'astro:transitions';
---

<Default />
<ClientRouter />
<MarkdownAlternate />
