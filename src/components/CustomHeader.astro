---
/**
 * Starlight Header override.
 *
 * Re-implements the upstream header layout with one change: on desktop the
 * search input is true-viewport-centered (`1fr auto 1fr`) instead of being
 * offset by the sidebar width. That stops the search bar from shifting when
 * navigating between splash pages (no sidebar) and content pages (with
 * sidebar). Mobile/tablet behaviour is unchanged — title on the left, search
 * icon on the right, primary controls collapsed.
 *
 * Children are imported via Starlight's virtual modules so any other component
 * overrides (Search, SiteTitle, etc.) configured in `astro.config.mjs` are
 * still respected. If you upgrade Starlight and the upstream Header changes
 * shape, re-sync from:
 *   node_modules/@astrojs/starlight/components/Header.astro
 */
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import AuthControl from './AuthControl.astro';
import { showAuthControls } from '../config/sidebar.mjs';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<div class="search-wrapper sl-flex print:hidden">
		{shouldRenderSearch && <Search />}
	</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		{showAuthControls && <AuthControl />}
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>

<style>
	.header {
		display: flex;
		gap: var(--sl-nav-gap);
		justify-content: space-between;
		align-items: center;
		height: 100%;
	}

	.title-wrapper {
		/* Prevent long titles overflowing and covering the search and menu
		 * buttons on narrow viewports. */
		overflow: clip;
		/* Avoid clipping focus ring around link inside title wrapper. */
		padding: 0.25rem;
		margin: -0.25rem;
		min-width: 0;
	}

	.right-group,
	.social-icons {
		gap: 1rem;
		align-items: center;
	}
	.social-icons::after {
		content: '';
		height: 2rem;
		border-inline-end: 1px solid var(--sl-color-gray-5);
	}

	@media (min-width: 50rem) {
		.header {
			display: grid;
			/* Equal-weight outer columns mean the centre column (search) stays
			 * locked to the viewport centre regardless of how wide the title or
			 * right-group end up. */
			grid-template-columns: 1fr auto 1fr;
			align-content: center;
		}

		.title-wrapper {
			justify-self: start;
		}

		.search-wrapper {
			justify-self: center;
			/* Match Starlight's default search button max-width so the input
			 * expands to its usual size; otherwise the auto grid cell would
			 * shrink-wrap to the icon-only state. */
			width: 22rem;
			max-width: 100%;
		}

		.right-group {
			justify-self: end;
		}
	}
</style>
