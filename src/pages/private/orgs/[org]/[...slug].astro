---
/**
 * Renders one org's `orgDocs` subtree. Never prerendered — see the sibling
 * route and wiki/private-docs.md.
 *
 * `src/middleware.ts` has already verified both the session and that the reader
 * belongs to `[org]`: a request for another org never reaches this file. It
 * also refuses the case where the route's `org` param and the request path
 * disagree (only reachable via a rewrite), which is what lets this file trust
 * `Astro.params.org` to build a collection id.
 */
import { getCollection, render } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { buildPrivateSidebar } from '../../../../lib/private-sidebar.mjs';

export const prerender = false;

const { org } = Astro.params;
// Note the asymmetry with the private route: an org's landing page lives at
// `org-docs/<org>/index.mdx`, which Astro collapses to the id `<org>` — so
// `/private/orgs/acme/` maps to `acme`, NOT `acme/index`. Deeper pages join
// naturally: `/private/orgs/acme/setup/` → `acme/setup`.
const id = [org, Astro.params.slug].filter(Boolean).join('/');
const entries = await getCollection('orgDocs');
const entry = entries.find((candidate) => candidate.id === id);
if (!entry) {
	return new Response('<!doctype html><title>404</title><h1>404 — Not found</h1>', {
		status: 404,
		headers: { 'content-type': 'text/html; charset=utf-8' },
	});
}
const { Content, headings } = await render(entry);
const sidebar = await buildPrivateSidebar(Astro.locals.session);
---

<StarlightPage
	frontmatter={{ title: entry.data.title, description: entry.data.description }}
	sidebar={sidebar}
	headings={headings}
>
	<Content />
</StarlightPage>
