---
/**
 * Every API reference declared in `src/config/api-reference.mjs`.
 *
 * One route file rather than one per reference: the config decides which exist,
 * so removing one from the list removes its route instead of leaving an
 * orphaned page file behind. Each entry names its own OpenAPI document and its
 * own layout.
 *
 * The layouts differ only in how much of Starlight's chrome stays on screen:
 *
 *   docs — the full Starlight page. Its sidebar lists every operation
 *          (generated from the document), so the API and the prose share one
 *          navigation tree.
 *   full — Starlight's sidebar steps aside via the `splash` template and Scalar
 *          takes the width, using its own operation navigation.
 *
 * Both keep the site header, the site theme, and the site search.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ScalarApiReference from '../../components/ScalarApiReference.astro';
import ApiSearchIndex from '../../components/ApiSearchIndex.astro';
import { enabledReferences } from '../../config/api-reference.mjs';

export function getStaticPaths() {
	return enabledReferences.map((reference) => ({
		// The slug *is* the rest param; an empty one renders `/api/` itself. Both
		// this and `routeFor()` read the same field, so the page cannot end up at
		// a path its own sidebar and search links do not point to.
		params: { reference: reference.slug || undefined },
		props: { reference },
	}));
}

const { reference } = Astro.props;
const isFullWidth = reference.layout === 'full';
---

<StarlightPage
	frontmatter={{
		title: reference.title,
		description: reference.description,
		...(isFullWidth ? { template: 'splash' as const } : {}),
		// Starlight builds its table of contents from server-rendered headings.
		// Scalar renders every heading in the browser, so the TOC could only ever
		// show a lone "Overview" — a column of chrome saying nothing.
		tableOfContents: false,
	}}
>
	<ApiSearchIndex spec={reference.spec} />
	<script is:inline>
		/**
		 * Honour the anchor the page was opened with.
		 *
		 * Scalar reads `location.hash` when it mounts and scrolls there — but it
		 * also runs a scroll-spy that rewrites the hash to whatever is on screen.
		 * On a cold load the spy can fire first, overwriting the incoming anchor
		 * with the top of the document before the router acts on it. The reader
		 * then lands at the introduction, and any shared deep link silently loses
		 * its place. It is a race, so it fails perhaps half the time.
		 *
		 * Recording the anchor before Scalar mounts and re-applying it once, after
		 * the document renders, settles the race in the reader's favour.
		 *
		 * `is:inline` keeps this in document order rather than being bundled and
		 * deferred, so the hash is captured before Scalar's bundle can touch it.
		 */
		(() => {
			const wanted = location.hash;
			if (!wanted) return;

			const container = document.querySelector('[data-ek-scalar]');
			if (!container) return;

			const deadline = Date.now() + 15_000;
			let done = false;

			const reapply = () => {
				if (done || Date.now() > deadline) return true;
				// Wait for Scalar to have rendered something to scroll to.
				if ((container.textContent ?? '').trim().length < 500) return false;

				done = true;
				if (location.hash !== wanted) {
					// Round-trip through empty so the router sees a change even when
					// the spy has already written this exact value back.
					location.hash = '';
					location.hash = wanted;
				}
				return true;
			};

			if (reapply()) return;

			const observer = new MutationObserver(() => {
				if (reapply()) observer.disconnect();
			});
			observer.observe(container, { childList: true, subtree: true });
			setTimeout(() => observer.disconnect(), 15_000);
		})();
	</script>
	<ScalarApiReference
		url={reference.specUrl}
		showSidebar={isFullWidth}
		layout={reference.layout}
	/>
</StarlightPage>

{/* Only the docs layout shows a Starlight sidebar to keep in step. */}
{!isFullWidth && (
	<script>
		/**
		 * Keep the sidebar's highlight on the operation currently in view.
		 *
		 * Starlight decides which sidebar link is current by comparing pathnames,
		 * so every generated operation link — all of which share this route and
		 * differ only by hash — resolves to "not current", and the highlight sits
		 * on "Overview" no matter how far the reader has scrolled.
		 *
		 * Scalar rewrites `location.hash` as the reader scrolls or clicks, so
		 * mirroring that onto `aria-current` gives the sidebar a live position. It
		 * is also the attribute the sidebar's own styling keys off, so the active
		 * row looks the same here as anywhere else in the site — and stays correct
		 * for assistive tech, which is what `aria-current` is actually for.
		 */
		const SIDEBAR_LINKS = '.sidebar-content a[href*="#"]';
		const OVERVIEW_LINK = `.sidebar-content a[href="${location.pathname}"]`;

		/**
		 * Compare hashes by their decoded form.
		 *
		 * Operation anchors contain path templates like `/payments/{payment_id}`,
		 * and the two sides spell those braces differently: `HTMLAnchorElement.hash`
		 * percent-encodes them, while `location.hash` — which Scalar writes
		 * directly — keeps them literal. Raw comparison therefore misses every
		 * parameterised operation, which is most of a real API.
		 */
		const decodedHash = (value: string) => {
			try {
				return decodeURIComponent(value);
			} catch {
				return value;
			}
		};

		function syncActiveOperation() {
			const hash = decodedHash(location.hash);

			const match = [...document.querySelectorAll<HTMLAnchorElement>(SIDEBAR_LINKS)].find(
				(link) => link.pathname === location.pathname && decodedHash(link.hash) === hash
			);

			for (const link of document.querySelectorAll<HTMLAnchorElement>(SIDEBAR_LINKS)) {
				link.removeAttribute('aria-current');
			}
			if (match) match.setAttribute('aria-current', 'page');

			// Hand "Overview" back the highlight above the first operation, and take
			// it away once one is in view — otherwise two rows look current.
			const overview = document.querySelector<HTMLAnchorElement>(OVERVIEW_LINK);
			if (overview) {
				if (match) overview.removeAttribute('aria-current');
				else overview.setAttribute('aria-current', 'page');
			}

			// Reveal the active row: its tag group is collapsed by default, so
			// without this the highlight lands inside a closed <details>.
			if (match) {
				const group = match.closest('details');
				if (group && !group.open) group.open = true;
			}
		}

		/**
		 * Re-check on scroll as well as on `hashchange`.
		 *
		 * `hashchange` alone misses almost everything here: Scalar moves the
		 * location with `history.pushState`, both when a link is followed and when
		 * its scroll-spy notices a new operation, and `pushState` fires no event.
		 * Watching scroll catches both, and turns the highlight into a live
		 * indicator that follows the reader rather than only updating on clicks.
		 */
		let lastHash: string | null = null;
		let queued = false;
		let settleTimer: ReturnType<typeof setTimeout>;

		function check() {
			if (location.hash === lastHash) return;
			lastHash = location.hash;
			syncActiveOperation();
		}

		function scheduleSync() {
			if (!queued) {
				queued = true;
				requestAnimationFrame(() => {
					queued = false;
					check();
				});
			}

			// Trailing check once scrolling stops. Scalar writes the final hash
			// *after* the last scroll event of a smooth scroll, so a frame-coalesced
			// check alone always settles one operation behind.
			clearTimeout(settleTimer);
			settleTimer = setTimeout(check, 200);
		}

		function start() {
			lastHash = null;
			scheduleSync();
		}

		start();
		addEventListener('hashchange', scheduleSync);
		addEventListener('scroll', scheduleSync, { passive: true });
		document.addEventListener('astro:page-load', start);
	</script>
)}

<style is:global>
	/*
	 * Full-width layout: let the reference span the whole main pane.
	 *
	 * The `splash` template still wraps content in `.sl-container`, which caps it
	 * near the reading-column width and centres it — right for a landing page,
	 * wrong for a two-pane API reference whose sidebar and request/response
	 * columns need the viewport.
	 */
	body:has([data-ek-scalar-layout='full']) .main-pane > .main-frame > .sl-container,
	body:has([data-ek-scalar-layout='full']) .content-panel > .sl-container {
		max-width: none;
		margin-inline: 0;
		padding: 0;
	}

	body:has([data-ek-scalar-layout='full']) .content-panel {
		padding: 0;
		border: none;
	}

	body:has([data-ek-scalar-layout='full']) .main-frame {
		padding-top: 0;
	}

	/*
	 * Docs layout: reclaim the reading-column width cap.
	 *
	 * Starlight caps `.sl-container` near 45rem for comfortable prose. An API
	 * reference is not prose — Scalar lays operations out in two columns, with the
	 * example request and response beside the description, and at 45rem that
	 * second column collapses underneath.
	 */
	body:has([data-ek-scalar-layout='docs']) .content-panel > .sl-container {
		max-width: none;
	}
</style>
